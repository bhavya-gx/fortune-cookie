# BlueBubbles server (runs on the Mac that stays on)
BB_URL=http://localhost:1234
BB_PASSWORD=change-me

# Port this bot listens on for BlueBubbles webhooks
PORT=8787

# Fortunes per person per day. 0 = unlimited. Default 5.
DAILY_CAP=5

# Optional. Phone numbers that skip the daily cap, comma separated, any format.
# UNLIMITED_PHONES=+1 555 010 0001, +1 555 010 0002
# Optional. The one number whose "fortune like / dislike" ratings are learned.
# LEARNING_PHONE=+1 555 010 0001

# Used for "per day" and the Sunday drop
TIMEZONE=America/Los_Angeles
# Hour (0-23, local) of the Sunday group fortune
WEEKLY_HOUR=10

# Optional. Without a key the bot uses its built-in deck of fortunes.
# ANTHROPIC_API_KEY=sk-ant-...
# FORTUNE_MODEL=claude-opus-5-5

# Where state.json and predictions.jsonl live (the public log)
DATA_DIR=./data

# How BlueBubbles sends: apple-script (default) or private-api
BB_SEND_METHOD=apple-script

# "dedicated" only if the Mac is signed into the bot's OWN Apple ID.
# Default (personal) only answers messages starting with "fortune" or 🥠.
BOT_ACCOUNT=personal
